# Copy to backend/.env for local overrides. All settings use the MY_PATH_ prefix.
MY_PATH_ENVIRONMENT=local
MY_PATH_LOG_LEVEL=INFO
MY_PATH_DATABASE_URL=sqlite+aiosqlite:///./my_path.db
# template (default, no network) or anthropic (needs ANTHROPIC_API_KEY)
MY_PATH_DRAFTER=template
MY_PATH_ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=
# Rule thresholds (placeholders until confirmed with coaching and aid staff)
MY_PATH_THRESHOLDS__SMALL_BALANCE_MAX_USD=1000
MY_PATH_THRESHOLDS__SMALL_BALANCE_DROP_WINDOW_DAYS=21
MY_PATH_THRESHOLDS__SILENT_AFTER_DAYS=10
